{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipVault",
  "version": "2.0.0",
  "identifier": "com.soham.clipvault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipVault",
        "width": 620,
        "height": 560,
        "minWidth": 520,
        "minHeight": 460,
        "visible": false
      },
      {
        "label": "quick",
        "title": "ClipVault — Quick clipboard",
        "url": "index.html?mode=quick",
        "width": 380,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Your clipboard, across your devices.",
    "longDescription": "Local clipboard history and encrypted clipboard sharing for Mac and Linux.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "resources": { "../extensions/clipvault/": "gnome-extension/" },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      },
      "rpm": { "depends": ["webkit2gtk4.1", "libappindicator-gtk3"] }
    }
  }
}
